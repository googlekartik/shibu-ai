# Copy this file to .env and fill in only what you need.
# The chatbot works fully without Gemini (rule engine, maths,
# search, documents, file generation). Gemini is the ONLY AI
# model, an optional extra used only for UNKNOWN / low-confidence
# questions and for explicit "ai: ..." messages. Removed provider
# variables (HF_TOKEN, HF_MODEL, HF_PROVIDER, HF_USE_LOCAL,
# HF_FORCE_LOCAL, OPENAI_API_KEY) are ignored and must not be set.

# --- Google Gemini API (the only AI model) ---
# Set GEMINI_API_KEY to use Google Gemini (gemini-2.5-flash by
# default, no download). The Gemini-only router
# (services/provider_router.py) always returns Gemini; the
# task-kind/length heuristic is diagnostics only. Never share
# the key, never commit .env, never paste it in chat. On a cloud host,
# set it in the host's Environment Variables dashboard, not in git.
# Get a key at Google AI Studio (aistudio.google.com). This is a
# DIFFERENT Google credential from Google sign-in (GOOGLE_CLIENT_ID /
# GOOGLE_CLIENT_SECRET): the sign-in credentials identify users, the
# Gemini key authorises model calls.
GEMINI_API_KEY=
# Model used by Gemini. Default when empty: gemini-2.5-flash. Use an
# id from your Google AI Studio model list.
GEMINI_MODEL=
# Gemini API base. Default when empty:
# https://generativelanguage.googleapis.com/v1beta
GEMINI_API_BASE=

# Provider routing: Gemini only (see services/provider_router.py).
# ROUTER_PREFERENCE: auto (default) or gemini. Any other value
# (including a removed provider's name) falls back to auto.
ROUTER_PREFERENCE=auto
# Gemini timeout (seconds, 5-120, default 20) and the confidence
# threshold that gates routing decisions (default 0.70). Gemini
# returns no numeric confidence; this threshold gates the semantic
# routing decision and is never presented as a Gemini score.
GEMINI_TIMEOUT_SECONDS=20
GEMINI_CONFIDENCE_THRESHOLD=0.70
# Semantic/paraphrase confidence threshold (default 0.70): below it
# the system asks for clarification instead of guessing.
SEMANTIC_CONFIDENCE_THRESHOLD=0.70

SECRET_KEY=change-me-to-a-random-string
PORT=5000

# --- Web search: Chrome-based search + LangSearch API ---
# Headless Chromium (Playwright, else Selenium) loads a search
# results page when installed; the LangSearch Web Search API
# below is the non-browser fallback when its key is set;
# otherwise search falls back to DuckDuckGo, then returns no
# results and chat falls back honestly.
# Chromium on Render is OPT-IN: install requirements-chrome.txt and
# run `playwright install chromium` in the build step (see
# docs/GEMINI_CHROME_UPGRADE.md). Without that install, headless
# Chromium does NOT run on Render. Setup for LangSearch: (1) sign
# up at langsearch.com, Dashboard > API keys, create a key; (2)
# put it in Render Environment only, never in git or chat. The
# free plan includes all Web Search features with a daily token
# allowance that resets at 00:00 UTC. The LangSearch key is a
# DIFFERENT credential from Gemini (GEMINI_API_KEY) and from
# Google sign-in. The old Google Programmable Search vars
# (GOOGLE_SEARCH_API_KEY / GOOGLE_SEARCH_CX / GOOGLE_SEARCH_BASE)
# are now ignored — delete them from Render if present.
LANGSEARCH_API_KEY=
# LangSearch API base. Default when empty:
# https://api.langsearch.com/v1
LANGSEARCH_API_BASE=
# Chrome search configuration. BROWSER_SEARCH_ENABLED=false
# disables the browser path entirely. CHROME_EXECUTABLE_PATH is
# optional (a Chrome/Chromium binary path; when empty, the
# automation library's bundled Chromium is used).
BROWSER_SEARCH_ENABLED=true
CHROME_EXECUTABLE_PATH=
SEARCH_TIMEOUT_SECONDS=20
MAX_SEARCH_RESULTS=5

# --- Developer panel (Phase 1, optional) ---
# Postgres connection string (Supabase pooler, transaction mode).
# Empty = SQLite store only. Set in Render Environment only, never
# in git or chat. See docs/DEV_PANEL.md for the full setup.
DATABASE_URL=
# Set to 1 only on the separate developer-panel Render service:
# / redirects to /dev and /api/chat is disabled there.
DEV_PANEL=0
# Owner identity for the panel (Google sign-in is still required).
# Set ONE of these on the dev service only. If none is set, the
# panel is locked for everyone (fail-closed). Never put a secret
# here — an email address / Google subject ID is an identifier.
DEV_OWNER_EMAIL=
DEV_OWNER_SUB=

# --- Google login (Step 4, optional) ---
# Create an OAuth client in Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID > Web application, with redirect URI
# http://127.0.0.1:5000/auth/callback (and your Render domain's
# /auth/callback on a host). Login is optional: without it, chat
# still works anonymously in-memory; with it, your name and avatar
# are remembered in this browser under google#<sub>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/callback

# --- Pinecone RAG (optional, production vector search) ---
# Set these in .env locally or Render Environment only — never in
# chat, never in git, never in the frontend. Without them, RAG runs
# on the SQLite fallback (development/tests) and /api/rag/status
# reports live Pinecone as blocked. This code never creates or
# changes an index: set PINECONE_INDEX_TYPE to the existing index's
# real type (dense or integrated), and make sure the embedding
# dimension matches the index dimension, or RAG is disabled with a
# migration message (new index + re-index, owner approval required).
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_INDEX_TYPE=dense
# Embedding for dense indexes only (ignored for integrated indexes).
# Default: Gemini text-embedding-004 = 768 dimensions, using the
# same GEMINI_API_KEY as chat (GEMINI_EMBEDDING_MODEL to change it).
# EMBEDDING_PROVIDER may also be "pinecone" (Pinecone Inference).
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_MODEL=text-embedding-004
# Version label recorded with each document. Change this before a deliberate
# embedding migration, then re-index documents; never mix dimensions in one index.
EMBEDDING_VERSION=gemini-text-embedding-004-v1
# RAG behaviour: backend auto|pinecone|sqlite, top_k, min_score,
# chunk_size, chunk_overlap. SQLite file for users/documents/
# conversations/messages (local file, ephemeral on Render free).
RAG_BACKEND=auto
RAG_TOP_K=5
RAG_MIN_SCORE=0.30
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
# Bounded batching/retries/cache. Client-side hybrid scoring is free and does
# not change the Pinecone index. Reranking remains OFF until you deliberately
# select a hosted Pinecone rerank model (it can incur provider usage).
EMBEDDING_BATCH_SIZE=64
PINECONE_UPSERT_BATCH_SIZE=80
CLOUD_RETRY_ATTEMPTS=3
RAG_QUERY_CACHE_TTL_SECONDS=120
RAG_MAX_CONTEXT_CHARS=9000
RAG_METADATA_TEXT_CHARS=1600
RAG_HYBRID_ENABLED=true
RAG_RERANK_ENABLED=false
PINECONE_RERANK_MODEL=
# Per-process protection for hosted embeddings/LLM/RAG. Set an edge-level
# limit as well if the service runs with multiple instances.
CLOUD_REQUEST_LIMIT=60
CLOUD_REQUEST_WINDOW_SECONDS=60
# Set true on Render to prohibit every local-model code path. The render.yaml
# supplied with this project already sets it. (Local-model code was
# removed with the Gemini-only upgrade; this flag is kept for parity.)
CLOUD_ONLY=false
SHIBU_SQLITE_PATH=
