# Copy this file to .env and fill in only what you need.
# The chatbot works fully without any of the Hugging Face settings below
# (rule engine, maths, search, documents, file generation). The LLM is
# an optional extra, used only for UNKNOWN / low-confidence questions
# and for explicit "ai: ..." messages.

# --- Option 0 (fastest response): ChatGPT API ---
# Set OPENAI_API_KEY to use OpenAI's gpt-4o-mini (fast, no provider
# routing, no download). When this key is set, Shibu uses OpenAI first,
# before Hugging Face. Never share the key, never commit .env, never
# paste it in chat. On a cloud host, set it in the host's Environment
# Variables dashboard, not in git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Option A (easiest, recommended on a small PC): Hugging Face API ---
# Get a free token at https://huggingface.co/settings/tokens. It MUST have
# the "Make calls to Inference Providers" permission — without it the
# router returns HTTP 401 even though /api/llm/status says "api".
# Never share it, never commit .env, never paste it in chat.
# With a token, no model is downloaded and no extra RAM is needed.
HF_TOKEN=
# Model used by the API. Default when empty: Qwen/Qwen2.5-3B-Instruct.
# The old default google/flan-t5-small is no longer the API default.
HF_MODEL=
# Provider for the router, e.g. featherless-ai, novita, auto. Leave empty
# and Shibu will try, in order: the plain model name, then model:auto,
# then (for Qwen models) model:featherless-ai, which is the only live
# provider for Qwen2.5-3B-Instruct. If you set this, it is tried first.
HF_PROVIDER=

# --- Option B (local model, no token needed) ---
# Set to 1 only if you installed requirements-llm.txt AND you accept a
# one-time download of ~1 GB (0.5B model) on first use. The model is
# chosen automatically from your RAM; leave HF_MODEL empty to auto-pick.
# On an ~8 GB PC the auto-pick is Qwen/Qwen2.5-0.5B-Instruct.
HF_USE_LOCAL=0
# Force local mode even if a token is set (normally the API wins).
HF_FORCE_LOCAL=0
# Optional: where to cache downloaded models (default: Hugging Face cache).
HF_HOME=
# Optional: 4bit — only with bitsandbytes installed, for trying a larger
# model on limited RAM. Leave empty for the normal setting.
HF_QUANTIZE=

SECRET_KEY=change-me-to-a-random-string
PORT=5000

# --- DynamoDB (Step 4, optional) ---
# The app works fully without DynamoDB (in-memory history, as before).
# Set DYNAMODB_ENABLED=1 only after creating the tables with
# infra/create_dynamodb_tables.py. Tables must already exist in the
# region below; the app never creates tables itself.
# AWS keys for the app go here ONLY for local testing, or in Render
# Environment Variables on a host — never in git, never in chat.
# For production, use the least-privilege app user from Step 6, not
# the shibu-setup user that created the tables.
DYNAMODB_ENABLED=0
AWS_REGION=ap-south-1
DYNAMODB_TABLE_PREFIX=shibu
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: DynamoDB Local endpoint for testing, e.g. http://localhost:8000
DYNAMODB_ENDPOINT=

# --- Google login (Step 4, optional) ---
# Create an OAuth client in Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID > Web application, with redirect URI
# http://127.0.0.1:5000/auth/callback (and your Render domain's
# /auth/callback on a host). Login is optional: without it, chat
# still works anonymously in-memory; with it, and DYNAMODB_ENABLED=1,
# chats are saved under google#<sub> and scoped to that user only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/callback
# Admin for /api/admin/usage and /api/dynamodb/sync-learning only.
# Set to your Google sub (the number after google# in /api/me).
# If this is empty, those endpoints refuse everyone — never open.
ADMIN_GOOGLE_SUB=

# --- Supabase pgvector search (search step, optional, not yet wired) ---
# Only approved, consented answers are indexed. The service_role key
# is server-only; never use the public anon key here, never in the
# frontend, never in git, never in chat.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
